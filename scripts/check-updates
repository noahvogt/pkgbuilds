#!/bin/bash
# Open a PR per package for
# - new upstream versions (sources in nvchecker.toml)
# - new commits in the AUR package a PKGBUILD is forked from (<pkg>/.aur-upstream)
# Meant to run in CI as a non-root user with GH_TOKEN set.
set -euo pipefail

cd "$(dirname "$0")/.."
base=$(git rev-parse --abbrev-ref HEAD)
# packages whose bump failed, makes the run fail once everything is checked
failed=()

install_makedepends() {
    local pkg=$1 dep deps=()
    # CI grants passwordless sudo for pacman, elsewhere leave the system alone
    sudo -n true 2>/dev/null || return 0
    while read -r dep; do
        dep=${dep%%[<>=]*}
        # AUR-only makedepends can't be installed, makepkg will report them
        if pacman -Si "$dep" >/dev/null 2>&1; then
            deps+=("$dep")
        else
            echo "makedepend $dep not in the repos, skipping"
        fi
    done < <(sed -n 's/^\tmakedepends\(_x86_64\)\? = //p' "$pkg/.SRCINFO")
    [ ${#deps[@]} -eq 0 ] || sudo -n pacman -S --needed --noconfirm "${deps[@]}"
}

branch_exists() {
    git ls-remote --exit-code --heads origin "$1" >/dev/null
}

# commit staged changes to a new branch and open a PR for it
open_pr() {
    local branch=$1 title=$2 body=$3
    git commit -q -m "$title"
    git push -q origin "HEAD:refs/heads/$branch"
    gh pr create --base "$base" --head "$branch" --title "$title" --body "${body:0:60000}"
    git checkout -q "$base"
}

check_upstream_versions() {
    local entries entry pkg ver cur branch status raw
    nvchecker -c nvchecker.toml
    # command substitution, not <(...): set -e sees a failing jq this way
    raw=$(jq -r '(.data // .) | to_entries[] | "\(.key) \(.value.version // .value)"' new_ver.json)
    mapfile -t entries <<<"$raw"
    for entry in "${entries[@]}"; do
        [ -n "$entry" ] || continue
        read -r pkg ver <<<"$entry"
        cur=$(sed -n 's/^\tpkgver = //p' "$pkg/.SRCINFO")
        [ "$(vercmp "$ver" "$cur")" -gt 0 ] || continue

        branch="update/$pkg-$ver"
        if branch_exists "$branch"; then
            echo "$pkg: $branch already exists, skipping"
            continue
        fi

        echo "$pkg: $cur -> $ver"
        git checkout -q -b "$branch" "$base"
        # fails e.g. when a release lacks the asset the PKGBUILD downloads,
        # skip the package so the others still get checked
        if ! scripts/bump "$pkg" "$ver" >bump.log 2>&1; then
            echo "::error::$pkg: bumping to $ver failed"
            tail -n 40 bump.log
            rm -f bump.log
            git checkout -q -f "$base"
            git branch -q -D "$branch"
            failed+=("$pkg")
            continue
        fi
        rm -f bump.log

        # prepare() applies the patches, so this catches ones needing a rebase.
        # --nodeps: runtime depends aren't needed for prepare(), makedepends
        # are installed explicitly since prepare() may use them.
        # --ignorearch: CI runs on x86_64, some packages are aarch64 only
        if { install_makedepends "$pkg" &&
            (cd "$pkg" && makepkg -o -f -A --nodeps --noconfirm); } >prepare.log 2>&1; then
            status="\`makepkg -o\` succeeded, all patches still apply."
        else
            status="**\`makepkg -o\` failed**, check whether patches need rebasing or makedepends are missing:
\`\`\`
$(tail -n 40 prepare.log)
\`\`\`"
        fi
        rm -rf "$pkg/src" prepare.log

        git add "$pkg"
        open_pr "$branch" "$pkg: update to $ver" "Upstream released $ver.

$status"
    done
}

check_aur_forks() {
    local file pkg name old new tmp diff branch
    for file in */.aur-upstream; do
        [ -e "$file" ] || continue
        pkg=${file%%/*}
        read -r name old <"$file"
        if ! new=$(git ls-remote "https://aur.archlinux.org/$name.git" refs/heads/master | cut -f1); then
            echo "$pkg: could not reach AUR $name, skipping"
            continue
        fi
        [ -n "$new" ] && [ "$new" != "$old" ] || continue

        branch="aur-upstream/$pkg-${new:0:8}"
        if branch_exists "$branch"; then
            echo "$pkg: $branch already exists, skipping"
            continue
        fi

        echo "$pkg: AUR $name changed ${old:0:8} -> ${new:0:8}"
        tmp=$(mktemp -d)
        if ! git clone -q "https://aur.archlinux.org/$name.git" "$tmp"; then
            echo "$pkg: could not clone AUR $name, skipping"
            rm -rf "$tmp"
            continue
        fi
        diff=$(git -C "$tmp" diff "$old" "$new" -- . ':!.SRCINFO')
        rm -rf "$tmp"

        git checkout -q -b "$branch" "$base"
        echo "$name $new" >"$file"
        git add "$file"
        open_pr "$branch" "$pkg: review changes of AUR $name" "The AUR package \`$name\` this PKGBUILD is forked from changed. Port the relevant parts onto this branch before merging, merging marks them as reviewed.

\`\`\`diff
$diff
\`\`\`"
    done
}

check_upstream_versions
check_aur_forks

if [ ${#failed[@]} -gt 0 ]; then
    echo "failed to bump: ${failed[*]}" >&2
    exit 1
fi
